# Copy this file to appsettings values or use dotnet user-secrets. Never commit real secrets.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres
Jwt__Key=replace_with_a_long_random_secret_min_32_chars
Jwt__Issuer=AssignmentSystem.Api
Jwt__Audience=AssignmentSystem.Client
Jwt__ExpiresMinutes=480
Cors__AllowedOrigins__0=http://localhost:3000
